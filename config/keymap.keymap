#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// オートマウスレイヤーの設定

&mkp_input_listener { input-processors = <&zip_temp_layer 1 500>; };

// オートマウスレイヤーの除外キーポジション設定

&zip_temp_layer {
    excluded-positions = <
        21 // J
        22 // K
        23 // L
    >;
};

// &ltの誤動作防止設定

&lt {
    tapping-term-ms = <240>;    /* 単発：<msec>待ったらレイヤーにする */
    quick-tap-ms = <200>;       /* 連打：<msec>以内に2回目を叩いたら即スペースにする */
    flavor = "tap-preferred";   /* 判定：時間内ならタップを優先する */
};

// &mtの誤動作防止設定

&mt {
    tapping-term-ms = <240>;    /* 単発：<msec>待ったらレイヤーにする */
    quick-tap-ms = <200>;       /* 連打：<msec>以内に2回目を叩いたら即スペースにする */
    flavor = "tap-preferred";   /* 判定：時間内ならタップを優先する */
};

/ {
    combos {
        compatible = "zmk,combos";

        Function_layer {
            bindings = <&mo 6>;
            key-positions = <44 45>;
        };

        mouse_button {
            bindings = <&mo 2>;
            key-positions = <43 42>;
        };

        bluetooth_layer {
            bindings = <&mo 7>;
            key-positions = <38 39 40>;
        };

        scroll_layer {
            bindings = <&mo 8>;
            key-positions = <22 23>;
        };

        kp_equal {
            bindings = <&kp EQUAL>;
            key-positions = <42 2 3>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <16 42 15>;
        };

        row_select {
            bindings = <&row_select>;
            key-positions = <28 29 42>;
        };

        scroll_layer2 {
            bindings = <&mo 8>;
            key-positions = <25 48>;
        };

        mouse_mode {
            bindings = <&to 2>;
            key-positions = <8 9 10>;
        };

        layer_0 {
            bindings = <&to 0>;
            key-positions = <34 36 35>;
        };

        kp_delete {
            bindings = <&kp DELETE>;
            key-positions = <12 26>;
        };
    };

    macros {
        row_select: row_select {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "ROW_SELECT";
        };
    };

    behaviors {
        lt_to: lt_to {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO";
            #binding-cells = <2>;
            bindings = <&mo>, <&to>;

            tapping-term-ms = <240>;
            flavor = "balanced";
        };

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        msc_v_up: msc_v_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MSC_V_UP";
            bindings = <&msc MOVE_Y(20)>, <&msc MOVE_Y(10)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        msc_v_down: msc_v_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MSC_V_DOWN";
            bindings = <&msc MOVE_Y(-20)>, <&msc MOVE_Y(-10)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default_Layer {
            bindings = <
&kp TAB     &kp Q     &kp W     &kp E            &kp R             &kp T        &none          &kp Y             &kp U  &kp I      &kp O           &kp P           &kp BACKSPACE
&kp LCTRL   &kp A     &kp S     &kp D            &kp F             &kp G        &kp BACKSPACE  &kp H             &kp J  &kp K      &kp L           &kp SEMICOLON   &kp ENTER
&kp LSHIFT  &kp Z     &kp X     &kp C            &kp V             &kp B        &kp DELETE     &kp N             &kp M  &kp COMMA  &kp DOT         &kp SLASH
&gresc      &kp LGUI  &kp LALT  &lt 3 LG(SPACE)  &lt 4 LANGUAGE_2  &lt 5 SPACE  &lt 5 SPACE    &lt 4 LANGUAGE_1                    &mo 8           &kp UP_ARROW    &mo 2
                                                                                                                                   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        Auto_mouse_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans
&to 0   &trans  &trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans  &trans
                                                                                  &trans    &trans  &trans
            >;
        };

        Mouse_Layer {
            bindings = <
&trans  &kp HOME        &kp UP_ARROW    &kp END          &none          &none               &trans       &kp F5          &mkp MB4        &kp LC(L)  &mkp MB5         &kp DELETE        &trans
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none          &msc MOVE_Y(1000)   &kp LA(TAB)  &msc SCRL_UP    &mkp MB1        &mkp MB3   &mkp MB2         &msc MOVE_Y(40)   &trans
&trans  &kp LS(HOME)    &row_select     &kp LS(END)      &kp BACKSPACE  &msc MOVE_Y(-1000)  &kp LC(TAB)  &msc SCRL_DOWN  &msc SCRL_LEFT  &kp LG(E)  &msc SCRL_RIGHT  &msc MOVE_Y(-40)
&to 0   &trans          &trans          &trans           &kp LC(Z)      &trans              &trans       &trans                                     &trans           &trans            &trans
                                                                                                                                                    &trans           &trans            &trans
            >;
        };

        ARROW_Layer {
            bindings = <
&trans  &kp HOME        &kp UP_ARROW    &kp END          &none          &none               &none          &none           &kp HOME        &kp UP_ARROW    &kp END          &kp DELETE     &trans
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none          &msc MOVE_Y(1000)   &kp BACKSPACE  &msc SCRL_UP    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_UP    &trans
&trans  &kp LS(HOME)    &row_select     &kp LS(END)      &kp BACKSPACE  &msc MOVE_Y(-1000)  &kp DELETE     &msc SCRL_DOWN  &kp LS(HOME)    &row_select     &kp LS(END)      &kp PAGE_DOWN
&trans  &trans          &trans          &trans           &kp LC(Z)      &trans              &trans         &trans                                          &trans           &trans         &trans
                                                                                                                                                           &trans           &trans         &trans
            >;
        };

        Number_Layer {
            bindings = <
&kp BACKSPACE         &kp KP_DOT             &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS      &none            &kp KP_DOT       &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS      &trans
&kp ENTER             &kp KP_NUMBER_0        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS     &kp EQUAL        &kp KP_NUMBER_0  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SUBTRACT  &trans
&kp LEFT_ARROW        &kp RIGHT_ARROW        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_SLASH     &kp KP_MULTIPLY  &kp COLON        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_SLASH
&kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL        &kp COLON        &trans           &kp KP_MULTIPLY  &trans           &trans                                             &trans           &trans           &trans
                                                                                                                                                                                     &trans           &trans           &trans
            >;
        };

        Symbol_Layer {
            bindings = <
&trans       &kp GRAVE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SQT        &kp DOUBLE_QUOTES  &none              &kp EXCLAMATION  &kp QUESTION  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS       &trans
&kp AT_SIGN  &kp TILDE  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp AMPERSAND  &kp HASH           &kp C_VOLUME_UP    &kp PLUS         &kp MINUS     &kp SEMICOLON         &kp COLON              &kp PIPE        &trans
&kp EQUAL    &kp CARET  &kp LESS_THAN     &kp GREATER_THAN   &kp PERCENT    &kp DOLLAR         &kp C_VOLUME_DOWN  &kp ASTERISK     &kp SLASH     &kp COMMA             &kp PERIOD             &kp UNDERSCORE
&trans       &trans     &trans            &trans             &trans         &trans             &trans             &trans                                               &trans                 &trans          &trans
                                                                                                                                                                       &trans                 &trans          &trans
            >;
        };

        Function_Layer {
            bindings = <
&trans  &none   &kp F7  &kp F8  &kp F9  &kp F12  &none   &none   &kp F7  &kp F8  &kp F9  &kp F12  &trans
&trans  &none   &kp F4  &kp F5  &kp F6  &kp F11  &none   &none   &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans  &none   &kp F1  &kp F2  &kp F3  &kp F10  &none   &none   &kp F1  &kp F2  &kp F3  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans                  &trans  &trans   &trans
                                                                                 &trans  &trans   &trans
            >;
        };

        System_Layer {
            bindings = <
&bootloader  &none  &none  &none  &none  &none  &none       &bt BT_PRV    &bt BT_NXT    &none         &none           &none         &none
&sys_reset   &none  &none  &none  &none  &none  &kp CAPS    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4  &none
&none        &none  &none  &none  &none  &none  &caps_word  &none         &none         &none         &none           &none
&none        &none  &none  &none  &none  &none  &kp INS     &kp INS                                   &bt BT_CLR_ALL  &none         &bt BT_CLR
                                                                                                      &none           &none         &none
            >;
        };

        Scroll_Layer {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none           &none             &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &msc SCRL_UP    &msc MOVE_Y(40)   &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &msc SCRL_DOWN  &msc MOVE_Y(-40)
&none  &none  &none  &none  &none  &none  &none  &none                &none           &none             &none
                                                                      &none           &none             &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
